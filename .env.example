EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:5000/api
EXPO_PUBLIC_SOCKET_URL=http://192.168.1.50:5000
EXPO_PUBLIC_SITE_NAME=Maun Pharmacy
# Google sign-in. WEB client id is passed as webClientId so the native ID token
# is audienced to the same Web client the API trusts. IOS client id is only used
# on iOS builds (leave blank for Android-only).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
